<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Los placeholders __VAULT_DIR__ los resuelve install.sh al cargar. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.secondbrain.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>__VAULT_DIR__/.claude/launchd/run-refresh.sh</string>
  </array>

  <!-- Cada hora en punto de 10:00 a 18:00, lunes a viernes (Weekday 1=Lun … 5=Vie).
       Las 08:30 quedan para el pipeline diario completo (com.secondbrain.daily).
       El trigger post-meeting (com.secondbrain.postmeeting) complementa con disparos
       event-driven tras cada reunión. Ajustá el horario/días a tu ritmo de trabajo. -->
